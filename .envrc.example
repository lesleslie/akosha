layout uv

# Phase 10: pgvector hot-store DSN (Postgres 16/17/18, requires `vector` extension).
# Used when AKOSHA__STORAGE__HOT__BACKEND=pgvector (see settings/akosha.yaml).
# Copy to .envrc and substitute your own credentials before `direnv allow`.
#
# DSN format: postgresql://<user>:<password>@<host>:<port>/<database>
# Local dev quickstart (Homebrew postgresql@16 + pgvector):
#   brew install postgresql@16 pgvector
#   brew services start postgresql@16
#   createdb akosha_pgvector
#   psql -d akosha_pgvector -c "CREATE EXTENSION vector;"
export AKOSHA__STORAGE__HOT__PG_URL="postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/akosha_pgvector"