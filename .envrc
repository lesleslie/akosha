layout uv

# Phase 10: pgvector hot-store DSN (Postgres 16/17/18, requires `vector` extension).
# Used when AKOSHA__STORAGE__HOT__BACKEND=pgvector (see settings/akosha.yaml).
# Local dev: createdb akosha_pgvector && psql -d akosha_pgvector -c "CREATE EXTENSION vector;"
export AKOSHA__STORAGE__HOT__PG_URL="postgresql://akosha:akosha@localhost:5432/akosha_pgvector"